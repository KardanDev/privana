{
  "name": "@privana/db",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts",
    "./client": "./prisma/generated/client.ts"
  },
  "scripts": {
    "build": "tsc -b",
    "check-types": "tsc -b",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed:demo": "varlock run -- bun scripts/seed-demo.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-ppg": "^7.10.0",
    "@prisma/client": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@privana/config": "workspace:*",
    "better-auth": "catalog:",
    "prisma": "^7.10.0",
    "typescript": "catalog:",
    "varlock": "catalog:"
  }
}
