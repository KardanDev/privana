  "narrative": {
    "northStar": "Proximidade",
    "overview": "The owner selected Proximidade on November 7, 2026 after comparing Galeria, Proximidade and Ritmo. This records the rendered, read-only direction studies in [the review packet](../../docs/planning/m015-brand/direction-review.md). It is the approved target for later M01.5 work; the current application still uses its incumbent tokens and fonts. PR acceptance and logo approval are separate review gates.\n\nCreators' work carries the visual interest. The surrounding interface is welcoming, legible and familiar: tinted navigation, clear selected states, generous media and economical operational rows. Public entry is photographic; Studio and owner views prioritize completing tasks. The platform is Brazil-first; its language, names and currency examples follow pt-BR conventions.",
    "keyCharacteristics": [
      "Royal purple and violet tonal layers.",
      "Humanist UI with expressive major headings.",
      "Mobile creator workflows and readable owner data."
    ],
    "rules": [
      {
        "name": "The Creator Content Rule",
        "body": "Keep content prominent and surrounding controls predictable.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do preserve familiar creator-platform navigation, one clear primary task and the separation of fan, Studio and owner workspaces.",
      "Do keep real creator media dominant and label fictional/sample data honestly; never turn seed totals into commercial proof.",
      "Do keep simulated payments clearly identified and server access state authoritative."
    ],
    "donts": [
      "Don't copy competitor marks, manufacture trust badges or imply that publishing approval verifies identity/age.",
      "Don't adopt the prototype's tiny demo badges or fixed preview toolbar as production design tokens. Their role is review context; required status/action labels need the later accessibility checks."
    ]
  }
