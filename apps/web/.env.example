# Copy to apps/web/.env only when that file does not already exist.
# Values below are placeholders. Never commit working credentials.
NODE_ENV=development

# Prisma Postgres cloud: copy the DIRECT TCP connection URL from Prisma Console.
# Keep the provider's host, database, credentials and sslmode exactly as supplied.
# Use postgres://...:5432/...?sslmode=require, not an HTTP/Accelerate URL.
DATABASE_URL=postgres://YOUR_DATABASE_USER:YOUR_DATABASE_PASSWORD@YOUR_PRISMA_DATABASE_HOST:5432/postgres?sslmode=require

# Generate an independent random secret of at least 32 characters, for example:
# bun -e "process.stdout.write(require('node:crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=43f4a7c9a86130d078623d526f0078009e8dfda7ead9aabb20832bc5afb26bc1
BETTER_AUTH_URL=http://localhost:3001

# Local mode writes verification/reset HTML to apps/web/.local-mail/.
# Production requires resend; it rejects preview.
EMAIL_DELIVERY_MODE=preview

# Required only when EMAIL_DELIVERY_MODE=resend.
# Set EMAIL_FROM to an address on your verified Resend sending domain.
RESEND_API_KEY=
EMAIL_FROM=

# Optional for starting/building the app; required for media operations.
# Connect a PRIVATE Vercel Blob store and copy its read/write token here.
UPSTASH_BLOB_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Live marketplace payments are deferred; the checkout is a demonstration.
# Set ALLOW_DEMO_SEED=1 only for an intentional development demo seed.
