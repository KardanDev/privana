{
  "hooks": {
    "afterFileEdit": [
      {
        "command": "bunx ultracite fix --skip=correctness/noUnusedImports --hook"
      }
    ],
    "postToolUse": [
      {
        "command": "[ ! -f \".cursor/skills/impeccable/scripts/impeccable\" ] || \".cursor/skills/impeccable/scripts/impeccable\" hook",
        "matcher": "^Write$",
        "timeout": 5
      }
    ]
  },
  "version": 1
}
